<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Display">
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Heading">
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Accent">
        <item name="android:textColor">@color/accent_light</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.PillButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/remote_button_bg</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Theme.TvGuard.PanelDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/parent_card_bg</item>
        <item name="android:colorAccent">@color/panel_blue_text</item>
        <item name="android:textColorPrimary">@color/panel_ink</item>
        <item name="android:textColorSecondary">@color/panel_muted</item>
    </style>
</resources>
