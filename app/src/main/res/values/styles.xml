<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvGuard.Lock" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="Theme.TvGuard.Console" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- PlayStation-style display tier: light weight, tight 1.25 line height. -->
    <style name="Text" />
    <style name="Text.Display">
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Heading">
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Body">
        <item name="android:textColor">@color/on_dark_mute</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textColor">@color/mute_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Accent">
        <item name="android:textColor">@color/accent_light</item>
        <item name="android:textSize">30sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Warning">
        <item name="android:textColor">@color/warning</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- All remote-selectable buttons share the pill vocabulary. -->
    <style name="Widget.PillButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/remote_button_bg</item>
        <item name="android:textColor">@color/on_dark</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="PanelText" parent="">
        <item name="android:textColor">@color/panel_ink</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="PanelText.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="PanelText.Heading">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="PanelText.Caption">
        <item name="android:textColor">@color/panel_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="PanelText.Value">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="Theme.TvGuard.PanelDialog" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:windowBackground">@drawable/parent_card_bg</item>
        <item name="android:textColorPrimary">@color/panel_ink</item>
        <item name="android:textColorSecondary">@color/panel_muted</item>
    </style>
</resources>
