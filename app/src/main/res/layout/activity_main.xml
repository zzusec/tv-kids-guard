<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_canvas"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:fillViewport="false"
        android:focusable="false"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/main_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/panel_columns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/status_column"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/parent_tv_icon" />

                        <TextView
                            android:id="@+id/panel_title"
                            style="@style/PanelText.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="家长管理" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/status_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/parent_card_bg"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:id="@+id/status_heading"
                            style="@style/PanelText.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="今日概览" />

                        <TextView
                            android:id="@+id/status_text"
                            style="@style/PanelText.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/parent_status_bg"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/panel_green" />

                        <TextView
                            android:id="@+id/today_override"
                            style="@style/PanelText.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="今天不限时"
                            android:textColor="@color/panel_amber"
                            android:visibility="gone" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/panel_line" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/PanelText.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="今天已看" />

                            <TextView
                                android:id="@+id/used_time_value"
                                style="@style/PanelText.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/PanelText.Caption"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="每天可看" />

                            <TextView
                                android:id="@+id/daily_limit_value"
                                style="@style/PanelText.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/bonus_summary"
                            style="@style/PanelText.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/panel_blue_text"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/update_text"
                        style="@style/PanelText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/panel_blue_text"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/warn_text"
                        style="@style/PanelText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/parent_notice_bg"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:textColor="@color/panel_amber"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/menu_column"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/menu_heading"
                            style="@style/PanelText.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="快捷操作" />

                        <TextView
                            android:id="@+id/menu_hint"
                            style="@style/PanelText.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="数字键或方向键操作" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/menu_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:descendantFocusability="afterDescendants"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/version_text"
                style="@style/PanelText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
