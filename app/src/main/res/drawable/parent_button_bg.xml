<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/panel_canvas" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/panel_blue_deep" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_blue" />
            <stroke android:width="2dp" android:color="@color/panel_blue_deep" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel_surface" />
            <stroke android:width="1dp" android:color="@color/panel_line" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
