<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#141516" />
            <stroke android:width="1dp" android:color="#26282C" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0064B7" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0070D1" />
            <stroke android:width="3dp" android:color="#53B1FF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181818" />
            <stroke android:width="1dp" android:color="#3E3E44" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
