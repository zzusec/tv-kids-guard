<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#18202A" />
            <stroke android:width="2dp" android:color="#39434F" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#087AA8" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#075A84" />
            <stroke android:width="3dp" android:color="#72D6FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#222E3C" />
            <stroke android:width="2dp" android:color="#536477" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
